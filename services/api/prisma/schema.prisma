// Phase 2 — database foundation. Design notes: docs/DATABASE.md
// Conventions: uuid PKs, created_at/updated_at everywhere, soft delete
// (deleted_at) on user-facing content, audit fields (created_by/updated_by).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  LISTENER
  ARTIST
  ADMIN
  // Admin V2 privilege model. SUPER_ADMIN is the highest privilege; the named
  // operational roles carry server-defined permission bundles (see
  // src/http/authorization.ts) plus optional per-admin extra grants.
  SUPER_ADMIN
  PLATFORM_ADMIN
  MODERATOR
  SUPPORT_ADMIN
  FINANCE_ADMIN
  CONTENT_ADMIN
  ARTIST_ADMIN
  ANALYTICS_ADMIN
}

enum AlbumType {
  ALBUM
  SINGLE
  EP
  COMPILATION
}

enum TrackStatus {
  PROCESSING
  READY
  FAILED
  TAKEDOWN
}

// Phase 14 — artist audio ingestion. Lifecycle of the audio pipeline for a
// track, independent of the catalog publication state (TrackStatus):
//   NONE       — no source audio has ever been uploaded
//   PENDING    — source stored, waiting for the transcoder
//   PROCESSING — transcoding / HLS packaging in progress
//   READY      — HLS package validated in storage and playable
//   FAILED     — processing failed; retryable (see audioError)
// Kept separate from TrackStatus so re-processing a published (READY) track
// never unpublishes it: the old HLS package keeps serving until the new one
// validates, and a failed re-upload leaves the catalog status untouched.
enum AudioIngestStatus {
  NONE
  PENDING
  PROCESSING
  READY
  FAILED
}

enum PlaylistVisibility {
  PRIVATE
  PUBLIC
  UNLISTED
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  EXPIRED
  REVOKED
}

// Phase 18 — subscriptions & entitlements. Store-side provider of a
// subscription. APPLE/GOOGLE are integration boundaries (real verification
// arrives in a later phase); DEV is the deterministic test/development
// adapter and must never be enabled in production.
enum SubscriptionProvider {
  APPLE
  GOOGLE
  DEV
}

// Phase 18 — plan/product abstraction. Product identifiers live in the
// database (configurable per environment) rather than in code, so Apple /
// Google product IDs can be set when store integration lands. No pricing is
// stored in this phase.
enum PlanType {
  INDIVIDUAL
  FAMILY
  STUDENT
}

// Phase 18 — provider-neutral subscription lifecycle events. Every applied
// event appends one SubscriptionEvent row; (provider, providerEventId) is
// unique so duplicate provider deliveries are idempotent and never create
// duplicate history.
enum SubscriptionEventType {
  SUBSCRIPTION_STARTED
  TRIAL_STARTED
  TRIAL_CONVERTED
  RENEWAL_SUCCEEDED
  PAYMENT_FAILED
  PAYMENT_RECOVERED
  PLAN_CHANGED
  SUBSCRIPTION_CANCELED
  SUBSCRIPTION_EXPIRED
  SUBSCRIPTION_REVOKED
  // Phase 19 — grace period (Apple DID_FAIL_TO_RENEW / Google IN_GRACE_PERIOD).
  SUBSCRIPTION_GRACE_PERIOD
}

// Phase 19 — whether the subscription state was established through real
// store verification (Apple/Google) or only through unverified input
// (DEV adapter). Playback never reads this — it is audit metadata.
enum VerificationStatus {
  UNVERIFIED
  VERIFIED
}

// Phase 17 — moderation foundation. Smallest maintainable moderation model
// for catalog content (artist/album/track): a report row carries moderation
// status, reason, timestamps, and the acting administrator. Auditable
// moderation history lives in admin_audit_logs (Phase 16), not here.
enum ModerationTargetType {
  ARTIST
  ALBUM
  TRACK
  // Phase 29 — community content report targets.
  ARTIST_POST
  POST_COMMENT
  // Phase 30 — commerce report targets.
  PRODUCT
  ARTIST_STORE
  // Admin governance — users themselves are reportable (harassment, spam).
  USER
}

enum ModerationStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  authSubject      String?   @unique @map("auth_subject")
  email            String    @unique @db.Citext
  emailVerified    Boolean   @default(false) @map("email_verified")
  // Null for users created via social login (no local password). Phase 3.
  passwordHash     String?   @map("password_hash")
  displayName      String    @map("display_name")
  avatarUrl        String?   @map("avatar_url")
  role             UserRole  @default(LISTENER)
  countryCode      String?   @map("country_code") @db.Char(2)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy        String?   @map("created_by") @db.Uuid
  updatedBy        String?   @map("updated_by") @db.Uuid
  // Admin governance — custom bans. bannedAt set = banned; bannedUntil null =
  // indefinite. Login and token refresh are blocked while banned.
  bannedAt         DateTime? @map("banned_at") @db.Timestamptz(6)
  banReason        String?   @map("ban_reason")
  bannedUntil      DateTime? @map("banned_until") @db.Timestamptz(6)
  // Admin governance — granular permission keys granted by a main admin.
  // Only meaningful when role is SUB_ADMIN; ADMIN bypasses checks.
  adminPermissions String[]  @default([]) @map("admin_permissions")

  artists                       Artist[]
  playlists                     Playlist[]
  playlistItemsAdded            PlaylistTrack[]                @relation("AddedBy")
  // Phase 27 — collaborative playlists.
  playlistMemberships           PlaylistMember[]
  invitationsCreated            PlaylistInvitation[]
  playlistChanges               PlaylistChange[]
  likes                         Like[]
  follows                       Follow[]
  listeningHistory              ListeningHistory[]
  subscriptions                 Subscription[]
  refreshTokens                 RefreshToken[]
  playbackSessions              PlaybackSession[]
  auditEvents                   AdminAuditLog[]
  playEvents                    PlayEvent[]
  offlineDownloadAuthorizations OfflineDownloadAuthorization[]
  reportsCreated                ModerationReport[]             @relation("ModerationReportCreatedBy")
  reportsReviewed               ModerationReport[]             @relation("ModerationReportReviewedBy")
  // Phase 28 — synchronized listening rooms.
  hostedRooms                   ListeningRoom[]                @relation("RoomHost")
  roomMemberships               ListeningRoomMember[]
  roomQueueItemsAdded           ListeningRoomQueueItem[]       @relation("RoomQueueItemAddedBy")
  roomInvitationsCreated        ListeningRoomInvitation[]      @relation("RoomInvitationCreatedBy")
  // Phase 29 — artist/fan community.
  authoredPosts                 ArtistPost[]                   @relation("ArtistPostAuthor")
  postComments                  PostComment[]                  @relation("PostCommentAuthor")
  postReactions                 PostReaction[]                 @relation("PostReactionUser")
  // Phase 30 — artist commerce.
  cart                          Cart?
  commerceOrders                CommerceOrder[]
  // Admin governance — chargebacks recorded + login history.
  chargebacksRecorded           Chargeback[]
  loginEvents                   LoginEvent[]
  featureFlagsUpdated           FeatureFlag[]
  platformSettingsUpdated       PlatformSetting[]

  @@index([role])
  @@map("users")
}

model Artist {
  id              String    @id @default(uuid()) @db.Uuid
  name            String
  ownerUserId     String?   @map("owner_user_id") @db.Uuid
  owner           User?     @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  verified        Boolean   @default(false)
  // Admin V2 — account-level suspension. Suspended artists are hidden from
  // public catalog listings (they 404 on public detail) but their rows and
  // history are preserved; restore clears these fields. Distinct from
  // soft-delete (deletedAt) and from track-level TAKEDOWN.
  suspendedAt     DateTime? @map("suspended_at") @db.Timestamptz(6)
  suspendedReason String?   @map("suspended_reason")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy       String?   @map("created_by") @db.Uuid
  updatedBy       String?   @map("updated_by") @db.Uuid

  profile                ArtistProfile?
  albums                 Album[]
  tracks                 Track[]
  followers              Follow[]
  // Phase 29 — artist/fan community.
  posts                  ArtistPost[]
  // Phase 30 — artist commerce.
  stores                 ArtistStore[]
  products               Product[]
  royaltyEarnings        RoyaltyEarning[]        @relation("ArtistRoyaltyEarnings")
  royaltyAdjustments     RoyaltyAdjustment[]     @relation("ArtistRoyaltyAdjustments")
  royaltyEligibleStreams RoyaltyEligibleStream[] @relation("ArtistRoyaltyEligibleStreams")

  @@index([ownerUserId])
  @@index([name])
  @@map("artists")
}

model ArtistProfile {
  id          String   @id @default(uuid()) @db.Uuid
  artistId    String   @unique @map("artist_id") @db.Uuid
  artist      Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  bio         String?
  imageUrl    String?  @map("image_url")
  bannerUrl   String?  @map("banner_url")
  website     String?
  socialLinks Json?    @map("social_links")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy   String?  @map("created_by") @db.Uuid
  updatedBy   String?  @map("updated_by") @db.Uuid

  @@map("artist_profiles")
}

model Album {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  artistId    String    @map("artist_id") @db.Uuid
  artist      Artist    @relation(fields: [artistId], references: [id], onDelete: Restrict)
  albumType   AlbumType @default(ALBUM) @map("album_type")
  releaseDate DateTime? @map("release_date") @db.Date
  coverArtUrl String?   @map("cover_art_url")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy   String?   @map("created_by") @db.Uuid
  updatedBy   String?   @map("updated_by") @db.Uuid

  tracks Track[]

  // Phase 29 — posts referencing this album (IDs only; catalog is the source of truth).
  referencedInPosts    ArtistPost[]
  // Phase 30 — commerce products referencing this album (IDs only).
  referencedInProducts Product[]

  @@index([artistId, releaseDate])
  @@map("albums")
}

model Track {
  id             String            @id @default(uuid()) @db.Uuid
  title          String
  artistId       String            @map("artist_id") @db.Uuid
  artist         Artist            @relation(fields: [artistId], references: [id], onDelete: Restrict)
  albumId        String?           @map("album_id") @db.Uuid
  album          Album?            @relation(fields: [albumId], references: [id], onDelete: Restrict)
  durationMs     Int               @map("duration_ms")
  trackNumber    Int?              @map("track_number")
  discNumber     Int               @default(1) @map("disc_number")
  isrc           String?           @unique
  status         TrackStatus       @default(PROCESSING)
  playCount      BigInt            @default(0) @map("play_count")
  // Phase 14 — audio ingestion pipeline state (see AudioIngestStatus).
  // audioSourceKey is the private storage key of the uploaded source file;
  // it is never exposed to clients.
  audioStatus    AudioIngestStatus @default(NONE) @map("audio_status")
  audioError     String?           @map("audio_error")
  audioSourceKey String?           @map("audio_source_key")
  audioReadyAt   DateTime?         @map("audio_ready_at") @db.Timestamptz(6)
  // Phase 25 — stable audio version. Incremented on every successful
  // re-ingestion where audio was already READY (a genuine replacement).
  // Offline download authorizations pin this version; a mismatch marks
  // the local download stale so it can never silently play outdated audio.
  audioVersion   Int               @default(1) @map("audio_version")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?         @map("deleted_at") @db.Timestamptz(6)
  createdBy      String?           @map("created_by") @db.Uuid
  updatedBy      String?           @map("updated_by") @db.Uuid

  genres                        TrackGenre[]
  playlistItems                 PlaylistTrack[]
  likes                         Like[]
  listeningHistory              ListeningHistory[]
  playbackSessions              PlaybackSession[]
  royaltyEarnings               RoyaltyEarning[]               @relation("TrackRoyaltyEarnings")
  royaltyEligibleStreams        RoyaltyEligibleStream[]
  offlineDownloadAuthorizations OfflineDownloadAuthorization[]
  // Phase 28 — synchronized listening rooms (queue items reference tracks;
  // rooms reference their current track; no audio URLs are ever stored).
  roomQueueItems                ListeningRoomQueueItem[]
  roomsAsCurrentTrack           ListeningRoom[]
  // Phase 29 — posts referencing this track (IDs only; catalog is the source of truth).
  referencedInPosts             ArtistPost[]
  // Phase 30 — commerce products referencing this track (IDs only).
  referencedInProducts          Product[]

  @@index([artistId])
  @@index([albumId, trackNumber])
  @@index([status])
  @@map("tracks")
}

model Genre {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tracks TrackGenre[]

  @@map("genres")
}

model TrackGenre {
  trackId   String   @map("track_id") @db.Uuid
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  genreId   String   @map("genre_id") @db.Uuid
  genre     Genre    @relation(fields: [genreId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([trackId, genreId])
  @@map("track_genres")
}

model Playlist {
  id              String             @id @default(uuid()) @db.Uuid
  title           String
  description     String?
  coverArtUrl     String?            @map("cover_art_url")
  visibility      PlaylistVisibility @default(PRIVATE)
  ownerUserId     String             @map("owner_user_id") @db.Uuid
  owner           User               @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?          @map("deleted_at") @db.Timestamptz(6)
  createdBy       String?            @map("created_by") @db.Uuid
  updatedBy       String?            @map("updated_by") @db.Uuid
  // Phase 27 — collaborative playlists: opt-in membership plus optimistic
  // concurrency for track mutations. Existing playlists keep revision 0 and
  // behave exactly as before until collaboration is enabled.
  isCollaborative Boolean            @default(false) @map("is_collaborative")
  revision        Int                @default(0)

  items PlaylistTrack[]

  members     PlaylistMember[]
  invitations PlaylistInvitation[]
  changes     PlaylistChange[]

  @@index([ownerUserId, updatedAt])
  @@map("playlists")
}

model PlaylistTrack {
  id            String   @id @default(uuid()) @db.Uuid
  playlistId    String   @map("playlist_id") @db.Uuid
  playlist      Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  trackId       String   @map("track_id") @db.Uuid
  track         Track    @relation(fields: [trackId], references: [id], onDelete: Restrict)
  position      Float
  addedByUserId String   @map("added_by_user_id") @db.Uuid
  addedBy       User     @relation("AddedBy", fields: [addedByUserId], references: [id], onDelete: Restrict)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([playlistId, position])
  @@map("playlist_tracks")
}

// Phase 27 — collaborative playlists. Collaboration is opt-in per playlist.
// Membership has only OWNER and EDITOR. The owner row is created when
// collaboration is enabled and removed when it is disabled.
enum CollaboratorRole {
  OWNER
  EDITOR
}

// Phase 27 — append-only playlist change history. Actions cover track edits,
// collaboration toggles, membership changes, and invitation lifecycle. This
// table is append-only by database trigger; application code only inserts.
enum PlaylistChangeAction {
  TRACK_ADDED
  TRACK_REMOVED
  TRACK_MOVED
  COLLAB_ENABLED
  COLLAB_DISABLED
  MEMBER_ADDED
  MEMBER_REMOVED
  MEMBER_LEFT
  INVITATION_CREATED
  INVITATION_ACCEPTED
  INVITATION_REVOKED
}

model PlaylistMember {
  playlistId String           @map("playlist_id") @db.Uuid
  playlist   Playlist         @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  userId     String           @map("user_id") @db.Uuid
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       CollaboratorRole
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([playlistId, userId])
  @@index([userId])
  @@map("playlist_members")
}

model PlaylistInvitation {
  id              String    @id @default(uuid()) @db.Uuid
  playlistId      String    @map("playlist_id") @db.Uuid
  playlist        Playlist  @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  // Phase 27 — invitation tokens are cryptographically secure random values.
  // Only the SHA-256 hash is stored; the raw token is returned once at issue.
  tokenHash       String    @unique @map("token_hash")
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdBy       User      @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt          DateTime? @map("used_at") @db.Timestamptz(6)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([playlistId])
  @@index([expiresAt])
  @@map("playlist_invitations")
}

model PlaylistChange {
  id          String               @id @default(uuid()) @db.Uuid
  playlistId  String               @map("playlist_id") @db.Uuid
  playlist    Playlist             @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  actorUserId String               @map("actor_user_id") @db.Uuid
  actor       User                 @relation(fields: [actorUserId], references: [id], onDelete: Cascade)
  action      PlaylistChangeAction
  // Track/item identifiers are stored as opaque UUIDs, not foreign keys, so
  // history survives track deletion and never blocks catalog maintenance.
  trackId     String?              @map("track_id") @db.Uuid
  itemId      String?              @map("item_id") @db.Uuid
  revision    Int
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([playlistId, createdAt])
  @@map("playlist_changes")
}

// Phase 28 — synchronized listening rooms. The server is authoritative for
// room state; every host command advances `revision` via an atomic
// compare-and-swap, and clients detect stale state by revision. Rooms are
// private and invite-only in this phase (no discovery surface).
enum RoomRole {
  HOST
  PARTICIPANT
}

enum RoomStatus {
  ACTIVE
  ENDED
}

enum RoomPlaybackState {
  PLAYING
  PAUSED
}

// Phase 28 — access policy. Only PRIVATE exists in this phase; rooms are
// never exposed through search, recommendations, playlists, or profiles.
enum RoomVisibility {
  PRIVATE
}

model ListeningRoom {
  id         String         @id @default(uuid()) @db.Uuid
  hostUserId String         @map("host_user_id") @db.Uuid
  host       User           @relation("RoomHost", fields: [hostUserId], references: [id], onDelete: Cascade)
  status     RoomStatus     @default(ACTIVE)
  visibility RoomVisibility @default(PRIVATE)

  // Authoritative playback state. `positionMs` is valid at `stateAt`
  // (server clock); clients extrapolate from elapsed server time.
  revision       Int               @default(0)
  playbackState  RoomPlaybackState @default(PAUSED) @map("playback_state")
  currentTrackId String?           @map("current_track_id") @db.Uuid
  currentTrack   Track?            @relation(fields: [currentTrackId], references: [id], onDelete: SetNull)
  queueIndex     Int               @default(0) @map("queue_index")
  positionMs     Int               @default(0) @map("position_ms")
  stateAt        DateTime          @default(now()) @map("state_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  endedAt   DateTime? @map("ended_at") @db.Timestamptz(6)

  members     ListeningRoomMember[]
  invitations ListeningRoomInvitation[]
  queueItems  ListeningRoomQueueItem[]

  @@index([hostUserId])
  @@index([status])
  @@map("listening_rooms")
}

model ListeningRoomQueueItem {
  id            String        @id @default(uuid()) @db.Uuid
  roomId        String        @map("room_id") @db.Uuid
  room          ListeningRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  trackId       String        @map("track_id") @db.Uuid
  track         Track         @relation(fields: [trackId], references: [id], onDelete: Restrict)
  position      Int
  addedByUserId String        @map("added_by_user_id") @db.Uuid
  addedBy       User          @relation("RoomQueueItemAddedBy", fields: [addedByUserId], references: [id], onDelete: Restrict)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([roomId, position])
  @@map("listening_room_queue_items")
}

model ListeningRoomMember {
  roomId   String        @map("room_id") @db.Uuid
  room     ListeningRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId   String        @map("user_id") @db.Uuid
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     RoomRole
  joinedAt DateTime      @default(now()) @map("joined_at") @db.Timestamptz(6)

  @@id([roomId, userId])
  @@index([userId])
  @@map("listening_room_members")
}

model ListeningRoomInvitation {
  id              String        @id @default(uuid()) @db.Uuid
  roomId          String        @map("room_id") @db.Uuid
  room            ListeningRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  // Phase 28 — invitation tokens are cryptographically secure random values.
  // Only the SHA-256 hash is stored; the raw token is returned once at issue.
  tokenHash       String        @unique @map("token_hash")
  createdByUserId String        @map("created_by_user_id") @db.Uuid
  createdBy       User          @relation("RoomInvitationCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  expiresAt       DateTime      @map("expires_at") @db.Timestamptz(6)
  usedAt          DateTime?     @map("used_at") @db.Timestamptz(6)
  revokedAt       DateTime?     @map("revoked_at") @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([roomId])
  @@index([expiresAt])
  @@map("listening_room_invitations")
}

// Phase 29 — artist/fan community. Deliberately minimal: artist-owned posts
// with optional catalog references (track/album IDs only — no metadata copy),
// flat comments, and a single idempotent reaction type.
//
// Moderation model follows Phase 17: REMOVED is an admin-only state,
// DELETED is a user soft-delete; rows are never hard-deleted so the audit
// trail and report targets stay resolvable. Only ACTIVE rows are served
// through public/community surfaces.
enum CommunityContentStatus {
  ACTIVE
  REMOVED
  DELETED
}

model ArtistPost {
  id           String                 @id @default(uuid()) @db.Uuid
  artistId     String                 @map("artist_id") @db.Uuid
  artist       Artist                 @relation(fields: [artistId], references: [id], onDelete: Restrict)
  authorUserId String                 @map("author_user_id") @db.Uuid
  author       User                   @relation("ArtistPostAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)
  body         String                 @db.Text
  // Optional catalog references — IDs only, resolved at read time so the
  // catalog stays the single source of truth. Null = no attachment.
  trackId      String?                @map("track_id") @db.Uuid
  track        Track?                 @relation(fields: [trackId], references: [id], onDelete: SetNull)
  albumId      String?                @map("album_id") @db.Uuid
  album        Album?                 @relation(fields: [albumId], references: [id], onDelete: SetNull)
  status       CommunityContentStatus @default(ACTIVE)
  // publishedAt is the stable feed ordering key (set once at creation;
  // edits bump updatedAt only, so edited posts do not jump the feed).
  publishedAt  DateTime               @default(now()) @map("published_at") @db.Timestamptz(6)
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  comments  PostComment[]
  reactions PostReaction[]

  @@index([artistId, publishedAt(sort: Desc)])
  @@index([status, publishedAt(sort: Desc)])
  @@map("artist_posts")
}

model PostComment {
  id           String                 @id @default(uuid()) @db.Uuid
  postId       String                 @map("post_id") @db.Uuid
  post         ArtistPost             @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorUserId String                 @map("author_user_id") @db.Uuid
  author       User                   @relation("PostCommentAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)
  body         String                 @db.Text
  status       CommunityContentStatus @default(ACTIVE)
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([postId, createdAt])
  @@map("post_comments")
}

// Single reaction type ("like") on posts only. The composite PK makes
// add/remove idempotent at the database level — no duplicate reactions.
model PostReaction {
  postId    String     @map("post_id") @db.Uuid
  post      ArtistPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String     @map("user_id") @db.Uuid
  user      User       @relation("PostReactionUser", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([postId, userId])
  @@map("post_reactions")
}

model Like {
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId   String   @map("track_id") @db.Uuid
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([userId, trackId])
  @@map("likes")
}

model Follow {
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  artistId  String   @map("artist_id") @db.Uuid
  artist    Artist   @relation(fields: [artistId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([userId, artistId])
  @@map("follows")
}

model ListeningHistory {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId    String   @map("track_id") @db.Uuid
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Restrict)
  playedAt   DateTime @default(now()) @map("played_at") @db.Timestamptz(6)
  progressMs Int?     @map("progress_ms")
  completed  Boolean  @default(false)

  @@index([userId, playedAt])
  @@map("listening_history")
}

// Phase 18 — plan/product catalog. Plans are stable, server-owned records;
// clients reference them by id (e.g. "premium_individual"). Store product
// IDs are nullable until real Apple/Google integration configures them.
model Plan {
  id              String   @id
  name            String
  planType        PlanType @map("plan_type")
  appleProductId  String?  @map("apple_product_id")
  googleProductId String?  @map("google_product_id")
  devProductId    String?  @map("dev_product_id")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                     String               @id @default(uuid()) @db.Uuid
  userId                 String               @map("user_id") @db.Uuid
  user                   User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId                 String               @map("plan_id")
  plan                   Plan                 @relation(fields: [planId], references: [id], onDelete: Restrict)
  // Phase 18 — provider is a typed enum (was free-form `store`). Legacy
  // dev rows with a NULL store backfill to DEV; see the Phase 18 migration.
  provider               SubscriptionProvider @default(DEV)
  status                 SubscriptionStatus   @default(ACTIVE)
  // Phase 18 — external subscription identifier from the store
  // (was `storeSubscriptionId`). Unique per provider so provider events are
  // idempotent and duplicate deliveries cannot fork subscription history.
  externalSubscriptionId String?              @map("external_subscription_id")
  currentPeriodStart     DateTime?            @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd       DateTime?            @map("current_period_end") @db.Timestamptz(6)
  canceledAt             DateTime?            @map("canceled_at") @db.Timestamptz(6)
  // Phase 19 — VERIFIED once a store adapter has verified this subscription
  // (signature/API checks). lastVerifiedAt records the most recent check.
  verificationStatus     VerificationStatus   @default(UNVERIFIED) @map("verification_status")
  lastVerifiedAt         DateTime?            @map("last_verified_at") @db.Timestamptz(6)
  createdAt              DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy              String?              @map("created_by") @db.Uuid
  updatedBy              String?              @map("updated_by") @db.Uuid

  events      SubscriptionEvent[]
  chargebacks Chargeback[]

  @@unique([provider, externalSubscriptionId])
  @@index([userId, status])
  @@index([userId, createdAt(sort: Desc)])
  @@map("subscriptions")
}

// Phase 18 — append-only subscription history. One row per applied provider
// event (facts only: no payment-card data, no secrets). Reconstructing "what
// happened" is always possible from this table plus the current row; status
// on Subscription is a cached projection, never the sole record.
model SubscriptionEvent {
  id              String                @id @default(uuid()) @db.Uuid
  subscriptionId  String                @map("subscription_id") @db.Uuid
  subscription    Subscription          @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  provider        SubscriptionProvider
  providerEventId String                @map("provider_event_id")
  eventType       SubscriptionEventType @map("event_type")
  statusFrom      SubscriptionStatus?   @map("status_from")
  statusTo        SubscriptionStatus?   @map("status_to")
  // Sanitized provider payload (plan code, period dates, cancel reason).
  // Never card data, never secrets.
  payload         Json                  @default("{}")
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([provider, providerEventId])
  @@index([subscriptionId, createdAt])
  @@map("subscription_events")
}

// Phase 3 — authentication. Only the SHA-256 hash of the opaque refresh token
// is stored; the raw token is shown to the client once, at issuance.
model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  // Set when this token was rotated: points at nothing by FK on purpose —
  // the replacement row is found via the same token family (userId). Kept as
  // a plain marker column for reuse detection.
  replacedAt DateTime? @map("replaced_at") @db.Timestamptz(6)
  // Admin governance — device facts for the "active devices" view.
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")

  @@index([userId])
  @@map("refresh_tokens")
}

// Phase 7 — streaming. Playback sessions gate every audio byte: manifests
// and segments are served only with a valid, unexpired session token, so the
// API never exposes permanent public audio URLs. Tokens are opaque; only the
// SHA-256 hash is stored (same pattern as Phase 3 refresh tokens).
model PlaybackSession {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId           String   @map("track_id") @db.Uuid
  track             Track    @relation(fields: [trackId], references: [id], onDelete: Restrict)
  // Phase 25 — null for synthetic offline sessions (no delivery token).
  tokenHash         String?  @unique @map("token_hash")
  // Phase 25 — identifies the synthetic session for one offline playback
  // session; null for online sessions. Unique per user.
  offlineSessionKey String?  @map("offline_session_key")
  expiresAt         DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  playEvents PlayEvent[]

  @@unique([userId, offlineSessionKey])
  @@index([userId])
  @@index([expiresAt])
  @@index([trackId, createdAt])
  @@map("playback_sessions")
}

// Phase 7 — streaming. Append-only stream telemetry (START / HEARTBEAT /
// COMPLETE / ERROR). This is the raw material for royalty reporting and
// fraud detection in later phases; it stays separate from the user-facing
// listening_history. Partition by month when volume demands it.
enum PlayEventType {
  START
  HEARTBEAT
  COMPLETE
  ERROR
}

model PlayEvent {
  id                     String                        @id @default(uuid()) @db.Uuid
  // Phase 25 — sessionId is always set. Events uploaded from offline
  // playback attach to a synthetic server-side PlaybackSession created for
  // their offlineSessionKey, so Phase 15 session/stream analytics keep
  // working unchanged. The authorization linkage is kept alongside.
  sessionId              String                        @map("session_id") @db.Uuid
  session                PlaybackSession               @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId                 String                        @map("user_id") @db.Uuid
  user                   User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId                String                        @map("track_id") @db.Uuid
  eventType              PlayEventType                 @map("event_type")
  positionMs             Int?                          @map("position_ms")
  createdAt              DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  // Phase 25 — offline event sync. offlineEventKey is a client-generated
  // UUID; its unique constraint is the idempotency mechanism for uploads
  // retried after network loss. offlineSessionKey groups the events of one
  // offline playback session (the "stream" unit for royalty semantics).
  // occurredAt is when playback actually happened offline; for offline
  // events createdAt is set from occurredAt so analytics bucket on actual
  // playback time, not upload time.
  offlineEventKey        String?                       @unique @map("offline_event_key")
  offlineAuthorizationId String?                       @map("offline_authorization_id") @db.Uuid
  offlineAuthorization   OfflineDownloadAuthorization? @relation(fields: [offlineAuthorizationId], references: [id], onDelete: SetNull)
  offlineSessionKey      String?                       @map("offline_session_key")
  occurredAt             DateTime?                     @map("occurred_at") @db.Timestamptz(6)

  @@index([sessionId, createdAt])
  @@index([trackId, createdAt])
  @@index([createdAt])
  @@index([offlineAuthorizationId])
  @@index([userId, offlineSessionKey])
  @@map("play_events")
}

// Phase 25 — offline downloads. A download authorization is a
// server-minted grant, distinct from playback sessions. It binds an
// authenticated user to a track at a pinned audio version, with two
// separate lifetimes (ADR-019):
// - downloadTokenExpiresAt: short delivery window for the opaque token
//   that fetches HLS segments (hash stored, raw token shown once).
// - expiresAt: the offline entitlement window (30 days, sliding on
//   successful revalidation). Offline playback is allowed only inside it.
model OfflineDownloadAuthorization {
  id                     String    @id @default(uuid()) @db.Uuid
  userId                 String    @map("user_id") @db.Uuid
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId                String    @map("track_id") @db.Uuid
  track                  Track     @relation(fields: [trackId], references: [id], onDelete: Cascade)
  audioVersion           Int       @map("audio_version")
  tokenHash              String    @unique @map("token_hash")
  downloadTokenExpiresAt DateTime  @map("download_token_expires_at") @db.Timestamptz(6)
  issuedAt               DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt              DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt              DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastValidatedAt        DateTime? @map("last_validated_at") @db.Timestamptz(6)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  playEvents PlayEvent[]

  @@unique([userId, trackId])
  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("offline_download_authorizations")
}

// Phase 16 — admin audit foundation. Append-only record of privileged admin
// actions (role changes, artist verification, ...). No updated_at/deleted_at:
// the migration adds a BEFORE UPDATE OR DELETE trigger enforcing immutability
// in depth, and the HTTP surface exposes only reads. actor is null when the
// user who performed the action has been hard-deleted (ON DELETE SET NULL).
model AdminAuditLog {
  id          String          @id @default(uuid()) @db.Uuid
  actorId     String?         @map("actor_id") @db.Uuid
  actor       User?           @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action      String
  targetType  String          @map("target_type")
  targetId    String?         @map("target_id") @db.Uuid
  metadata    Json            @default("{}")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  // Admin governance — reversibility. A reversal is a NEW row pointing at the
  // original via reversalOf; beforeState/afterState carry the facts needed to
  // invert the action (never secrets).
  reversible  Boolean         @default(false)
  beforeState Json?           @map("before_state")
  afterState  Json?           @map("after_state")
  reversalOf  String?         @map("reversal_of") @db.Uuid
  original    AdminAuditLog?  @relation("AuditReversal", fields: [reversalOf], references: [id], onDelete: SetNull)
  reversedBy  AdminAuditLog[] @relation("AuditReversal")

  @@index([createdAt(sort: Desc)])
  @@index([action])
  @@index([actorId])
  @@map("admin_audit_logs")
}

// Admin governance — a recorded chargeback auto-cancels its subscription.
// Recording is the integration point: the (mock) provider has no webhooks,
// so chargebacks enter through the admin console and are fully audited.
model Chargeback {
  id             String       @id @default(uuid()) @db.Uuid
  subscriptionId String       @map("subscription_id") @db.Uuid
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  providerRef    String?      @map("provider_ref")
  amountCents    Int?         @map("amount_cents")
  currency       String?      @db.Char(3)
  reason         String?
  recordedBy     String?      @map("recorded_by") @db.Uuid
  recorder       User?        @relation(fields: [recordedBy], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([subscriptionId])
  @@map("chargebacks")
}

// Admin governance — every login attempt, success or failure, with network
// facts for the security timeline. Failed attempts store no password material.
model LoginEvent {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email         String
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  success       Boolean
  failureReason String?  @map("failure_reason")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt(sort: Desc)])
  @@map("login_events")
}

// Admin V2 — feature flags. Controlled via SUPER_ADMIN-gated endpoints;
// every change writes an audit row. rolloutPercent allows percentage
// rollouts where the consuming architecture supports it.
model FeatureFlag {
  key            String   @id
  enabled        Boolean  @default(false)
  rolloutPercent Int      @default(100) @map("rollout_percent")
  description    String?
  updatedBy      String?  @map("updated_by") @db.Uuid
  updater        User?    @relation(fields: [updatedBy], references: [id], onDelete: SetNull)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("feature_flags")
}

// Admin V2 — platform settings. Strongly typed: every key has a server-side
// validator (see governance service SETTING_DEFINITIONS); unknown keys and
// out-of-range values are rejected. Emergency controls live under
// "emergency.*" and are SUPER_ADMIN-only.
model PlatformSetting {
  key       String   @id
  value     Json     @db.JsonB
  updatedBy String?  @map("updated_by") @db.Uuid
  updater   User?    @relation(fields: [updatedBy], references: [id], onDelete: SetNull)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("platform_settings")
}

// Phase 17 — moderation foundation. A report flags one catalog entity
// (artist, album, or track) for operator review. targetId is intentionally
// not a foreign key: targets are polymorphic and soft-deleted content must
// remain reportable. Status transitions and edits are recorded as
// admin_audit_logs rows; the report row itself carries only current state.
model ModerationReport {
  id           String               @id @default(uuid()) @db.Uuid
  targetType   ModerationTargetType @map("target_type")
  targetId     String               @map("target_id") @db.Uuid
  reason       String               @db.Text
  details      String?              @db.Text
  status       ModerationStatus     @default(OPEN)
  createdById  String?              @map("created_by_id") @db.Uuid
  createdBy    User?                @relation("ModerationReportCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedById String?              @map("reviewed_by_id") @db.Uuid
  reviewedBy   User?                @relation("ModerationReportReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status])
  @@index([targetType, targetId])
  @@index([createdAt(sort: Desc)])
  @@map("moderation_reports")
}

// Phase 21 — Royalty Engine & Auditable Artist Earnings.
// Financial accounting foundation. All money is NUMERIC(19,4); the
// calculation service works in integer minor units and rounds per policy.
// royalty_revenue_inputs, royalty_earnings, and royalty_adjustments are
// append-only (DB triggers reject UPDATE/DELETE). Policies are immutable
// once used. See migration 20260922000004_phase21_royalties.

model RoyaltyPolicy {
  id                   String   @id @default(uuid()) @db.Uuid
  version              Int      @unique
  name                 String
  status               String   @default("DRAFT")
  // Percentage of net revenue for the artist pool (e.g., 70.00 = 70%).
  // PLACEHOLDER — production value must be configured before launch.
  artistPoolPercentage Decimal  @map("artist_pool_percentage") @db.Decimal(7, 4)
  minimumStreams       Int?     @map("minimum_streams")
  currency             String   @default("USD")
  roundingMode         String   @default("HALF_UP") @map("rounding_mode")
  config               Json     @default("{}")
  effectiveFrom        DateTime @map("effective_from") @db.Timestamptz(6)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy            String?  @map("created_by") @db.Uuid

  runs RoyaltyCalculationRun[]

  @@map("royalty_policies")
}

model RoyaltyPeriod {
  id          String   @id @default(uuid()) @db.Uuid
  periodStart DateTime @map("period_start") @db.Timestamptz(6)
  periodEnd   DateTime @map("period_end") @db.Timestamptz(6)
  currency    String   @default("USD")
  status      String   @default("OPEN")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   String?  @map("created_by") @db.Uuid

  revenueInputs RoyaltyRevenueInput[]
  runs          RoyaltyCalculationRun[]

  @@unique([periodStart, periodEnd])
  @@map("royalty_periods")
}

model RoyaltyRevenueInput {
  id          String        @id @default(uuid()) @db.Uuid
  periodId    String        @map("period_id") @db.Uuid
  period      RoyaltyPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)
  source      String
  currency    String
  grossAmount Decimal       @map("gross_amount") @db.Decimal(19, 4)
  deductions  Decimal       @default(0) @map("deductions") @db.Decimal(19, 4)
  netAmount   Decimal       @map("net_amount") @db.Decimal(19, 4)
  referenceId String        @unique @map("reference_id")
  fxReference String?       @map("fx_reference")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   String?       @map("created_by") @db.Uuid

  @@index([periodId])
  @@map("royalty_revenue_inputs")
}

model RoyaltyCalculationRun {
  id                   String        @id @default(uuid()) @db.Uuid
  periodId             String        @map("period_id") @db.Uuid
  period               RoyaltyPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)
  policyId             String        @map("policy_id") @db.Uuid
  policy               RoyaltyPolicy @relation(fields: [policyId], references: [id], onDelete: Restrict)
  status               String        @default("PENDING")
  runKey               String        @unique @map("run_key")
  revenueSnapshot      Json          @default("{}") @map("revenue_snapshot")
  totalEligibleStreams BigInt        @default(0) @map("total_eligible_streams")
  royaltyPool          Decimal       @default(0) @map("royalty_pool") @db.Decimal(19, 4)
  totalAllocated       Decimal       @default(0) @map("total_allocated") @db.Decimal(19, 4)
  residualAmount       Decimal       @default(0) @map("residual_amount") @db.Decimal(19, 4)
  currency             String
  startedAt            DateTime?     @map("started_at") @db.Timestamptz(6)
  completedAt          DateTime?     @map("completed_at") @db.Timestamptz(6)
  error                String?
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy            String?       @map("created_by") @db.Uuid

  earnings        RoyaltyEarning[]
  adjustments     RoyaltyAdjustment[]
  eligibleStreams RoyaltyEligibleStream[]

  @@index([periodId])
  @@map("royalty_calculation_runs")
}

model RoyaltyEarning {
  id                   String                @id @default(uuid()) @db.Uuid
  runId                String                @map("run_id") @db.Uuid
  run                  RoyaltyCalculationRun @relation(fields: [runId], references: [id], onDelete: Restrict)
  artistId             String                @map("artist_id") @db.Uuid
  artist               Artist                @relation("ArtistRoyaltyEarnings", fields: [artistId], references: [id], onDelete: Restrict)
  trackId              String                @map("track_id") @db.Uuid
  track                Track                 @relation("TrackRoyaltyEarnings", fields: [trackId], references: [id], onDelete: Restrict)
  eligibleStreams      BigInt                @map("eligible_streams")
  allocationPercentage Decimal               @map("allocation_percentage") @db.Decimal(9, 6)
  grossAmount          Decimal               @map("gross_amount") @db.Decimal(19, 4)
  adjustmentsTotal     Decimal               @default(0) @map("adjustments_total") @db.Decimal(19, 4)
  finalAmount          Decimal               @map("final_amount") @db.Decimal(19, 4)
  currency             String
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  adjustments RoyaltyAdjustment[]

  @@unique([runId, artistId, trackId])
  @@index([runId])
  @@index([artistId])
  @@index([trackId])
  @@map("royalty_earnings")
}

model RoyaltyAdjustment {
  id          String                @id @default(uuid()) @db.Uuid
  runId       String                @map("run_id") @db.Uuid
  run         RoyaltyCalculationRun @relation(fields: [runId], references: [id], onDelete: Restrict)
  earningId   String?               @map("earning_id") @db.Uuid
  earning     RoyaltyEarning?       @relation(fields: [earningId], references: [id], onDelete: Restrict)
  artistId    String                @map("artist_id") @db.Uuid
  artist      Artist                @relation("ArtistRoyaltyAdjustments", fields: [artistId], references: [id], onDelete: Restrict)
  amount      Decimal               @db.Decimal(19, 4)
  currency    String
  reason      String
  referenceId String                @unique @map("reference_id")
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   String?               @map("created_by") @db.Uuid

  @@index([runId])
  @@index([earningId])
  @@map("royalty_adjustments")
}

model RoyaltyEligibleStream {
  id                String                @id @default(uuid()) @db.Uuid
  runId             String                @map("run_id") @db.Uuid
  run               RoyaltyCalculationRun @relation(fields: [runId], references: [id], onDelete: Restrict)
  playbackSessionId String                @map("playback_session_id") @db.Uuid
  trackId           String                @map("track_id") @db.Uuid
  track             Track                 @relation(fields: [trackId], references: [id], onDelete: Restrict)
  artistId          String                @map("artist_id") @db.Uuid
  artist            Artist                @relation("ArtistRoyaltyEligibleStreams", fields: [artistId], references: [id], onDelete: Restrict)
  sessionCreatedAt  DateTime              @map("session_created_at") @db.Timestamptz(6)
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([runId, playbackSessionId], map: "royalty_eligible_streams_run_session_key")
  @@index([runId])
  @@index([trackId])
  @@index([artistId])
  @@map("royalty_eligible_streams")
}

// ---------------------------------------------------------------------------
// Phase 30 — artist commerce. Physical merchandise storefronts, products,
// inventory, carts, orders, and provider-neutral payments.
//
// Financial boundaries (do not relax without a new ADR):
// - Commerce money NEVER touches royalty tables, subscription tables, or
//   playback events. Separate tables, separate code paths, separate audit
//   actions. Commerce revenue is not part of the royalty pool.
// - All money is integer minor units (cents). Currency is explicit on every
//   monetary record. No floating point, no silent conversion.
// - commerce_payment_events is append-only (DB trigger, like Phase 18).
// - Payment state and order fulfillment state are separate state machines.
// - Only verified provider state (verifyPayment / verified webhook) moves
//   money. Client callbacks are never authoritative.
// - Shipping addresses are PII: exposed only to buyer, store owner, ADMIN.

enum StoreStatus {
  ACTIVE
  PAUSED
  SUSPENDED
}

/// Controlled product taxonomy. MUSIC means physical music media
/// (vinyl, CD, cassette) in Phase 30 — digital downloads are out of scope.
enum ProductType {
  APPAREL
  ACCESSORY
  MUSIC
  ART
  OTHER
}

enum ProductStatus {
  DRAFT
  ACTIVE
  PAUSED
  SOLD_OUT
  ARCHIVED
  REMOVED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELED
  REFUNDED
}

enum CommercePaymentStatus {
  INITIATED
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
  REFUNDED
}

enum CommerceRefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model ArtistStore {
  id                String      @id @default(uuid()) @db.Uuid
  artistId          String      @unique @map("artist_id") @db.Uuid
  artist            Artist      @relation(fields: [artistId], references: [id], onDelete: Restrict)
  name              String
  description       String?
  status            StoreStatus @default(ACTIVE)
  imageUrl          String?     @map("image_url")
  bannerUrl         String?     @map("banner_url")
  contactEmail      String?     @map("contact_email")
  contactUrl        String?     @map("contact_url")
  /// ISO 4217. Fixed at creation; Phase 30 does not convert currencies.
  currency          String      @default("USD") @db.Char(3)
  /// Flat shipping fee in minor units; 0 = free/unset. Tax is not calculated
  /// in Phase 30 (documented placeholder: taxCents = 0 on orders).
  shippingFlatCents Int         @default(0) @map("shipping_flat_cents")
  /// Per-store order number sequence, incremented atomically at checkout.
  orderSequence     Int         @default(0) @map("order_sequence")
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  products Product[]
  orders   CommerceOrder[]

  @@map("artist_stores")
}

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  storeId     String        @map("store_id") @db.Uuid
  store       ArtistStore   @relation(fields: [storeId], references: [id], onDelete: Restrict)
  artistId    String        @map("artist_id") @db.Uuid
  artist      Artist        @relation(fields: [artistId], references: [id], onDelete: Restrict)
  title       String
  description String?
  type        ProductType
  status      ProductStatus @default(DRAFT)
  /// Integer minor units. Never float.
  priceCents  Int           @map("price_cents")
  currency    String        @db.Char(3)
  sku         String?
  imageUrl    String?       @map("image_url")
  /// Optional catalog references (IDs only, same-artist enforced in service).
  trackId     String?       @map("track_id") @db.Uuid
  track       Track?        @relation(fields: [trackId], references: [id], onDelete: SetNull)
  albumId     String?       @map("album_id") @db.Uuid
  album       Album?        @relation(fields: [albumId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  variants   ProductVariant[]
  images     ProductImage[]
  inventory  InventoryItem[]
  cartItems  CartItem[]
  orderItems CommerceOrderItem[]

  @@index([storeId, status])
  @@index([artistId, status])
  @@map("products")
}

model ProductVariant {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Controlled free text, e.g. "Large", "Black / XL". Not a generic
  /// options engine — one flat variant list per product.
  name       String
  sku        String?
  priceCents Int      @map("price_cents")
  currency   String   @db.Char(3)
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  inventory  InventoryItem[]
  cartItems  CartItem[]
  orderItems CommerceOrderItem[]

  @@index([productId, sortOrder])
  @@map("product_variants")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageUrl  String   @map("image_url")
  altText   String?  @map("alt_text")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([productId, sortOrder])
  @@map("product_images")
}

/// One row per purchasable unit: the product itself (variantId NULL) or one
/// row per variant. Partial unique indexes (see migration) enforce this.
model InventoryItem {
  id                String          @id @default(uuid()) @db.Uuid
  productId         String          @map("product_id") @db.Uuid
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId         String?         @map("variant_id") @db.Uuid
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantityAvailable Int             @default(0) @map("quantity_available")
  quantityReserved  Int             @default(0) @map("quantity_reserved")
  quantitySold      Int             @default(0) @map("quantity_sold")
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([productId])
  @@map("inventory_items")
}

model Cart {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  items CartItem[]

  @@map("carts")
}

/// Cart lines carry NO prices — prices are always re-read server-side at
/// checkout. Partial unique indexes (see migration) prevent duplicate lines.
model CartItem {
  id        String          @id @default(uuid()) @db.Uuid
  cartId    String          @map("cart_id") @db.Uuid
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String          @map("product_id") @db.Uuid
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?         @map("variant_id") @db.Uuid
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([cartId])
  @@map("cart_items")
}

/// One store per order (multi-artist carts are checked out per store).
/// Line items are immutable snapshots — product edits/archives never rewrite
/// history. Shipping address is PII: restricted to buyer, store owner, ADMIN.
model CommerceOrder {
  id              String      @id @default(uuid()) @db.Uuid
  orderNumber     String      @unique @map("order_number")
  userId          String      @map("user_id") @db.Uuid
  user            User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  storeId         String      @map("store_id") @db.Uuid
  store           ArtistStore @relation(fields: [storeId], references: [id], onDelete: Restrict)
  status          OrderStatus @default(PENDING_PAYMENT)
  currency        String      @db.Char(3)
  subtotalCents   Int         @map("subtotal_cents")
  shippingCents   Int         @map("shipping_cents")
  /// Phase 30: always 0. Production tax rules are jurisdiction-specific and
  /// out of scope; the field exists so the snapshot shape is stable.
  taxCents        Int         @default(0) @map("tax_cents")
  totalCents      Int         @map("total_cents")
  /// Client-supplied idempotency key, unique per user. Retried checkouts
  /// with the same key return the original order instead of double-charging.
  idempotencyKey  String      @map("idempotency_key")
  shippingName    String?     @map("shipping_name")
  shippingLine1   String?     @map("shipping_line1")
  shippingLine2   String?     @map("shipping_line2")
  shippingCity    String?     @map("shipping_city")
  shippingRegion  String?     @map("shipping_region")
  shippingPostal  String?     @map("shipping_postal")
  shippingCountry String?     @map("shipping_country")
  shippingPhone   String?     @map("shipping_phone")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  items    CommerceOrderItem[]
  payments CommercePayment[]
  refunds  CommerceRefund[]

  @@unique([userId, idempotencyKey], map: "commerce_orders_user_idem_key")
  @@index([userId, createdAt(sort: Desc)])
  @@index([storeId, createdAt(sort: Desc)])
  @@index([status])
  @@map("commerce_orders")
}

model CommerceOrderItem {
  id             String          @id @default(uuid()) @db.Uuid
  orderId        String          @map("order_id") @db.Uuid
  order          CommerceOrder   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  productId      String          @map("product_id") @db.Uuid
  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId      String?         @map("variant_id") @db.Uuid
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  /// Purchase-time snapshots. Never updated after creation.
  productTitle   String          @map("product_title")
  variantName    String?         @map("variant_name")
  sku            String?
  quantity       Int
  unitPriceCents Int             @map("unit_price_cents")
  currency       String          @db.Char(3)

  @@index([orderId])
  @@map("commerce_order_items")
}

/// Provider-neutral payment record. Stores ONLY provider-safe references —
/// never card numbers, CVV, or full credentials.
model CommercePayment {
  id                String                @id @default(uuid()) @db.Uuid
  orderId           String                @unique @map("order_id") @db.Uuid
  order             CommerceOrder         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  /// Provider id, e.g. 'mock'. Validated in code (provider-neutral String,
  /// not an enum, so new providers need no migration).
  provider          String
  providerPaymentId String                @map("provider_payment_id")
  status            CommercePaymentStatus @default(INITIATED)
  amountCents       Int                   @map("amount_cents")
  currency          String                @db.Char(3)
  idempotencyKey    String                @unique @map("idempotency_key")
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  events  CommercePaymentEvent[]
  refunds CommerceRefund[]

  @@index([provider, providerPaymentId])
  @@map("commerce_payments")
}

/// Immutable provider event record. Webhook processing is idempotent via the
/// unique providerEventId — the same event is never applied twice.
model CommercePaymentEvent {
  id              String          @id @default(uuid()) @db.Uuid
  paymentId       String          @map("payment_id") @db.Uuid
  payment         CommercePayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  providerEventId String          @unique @map("provider_event_id")
  eventType       String          @map("event_type")
  /// Sanitized provider payload (no secrets; mock payloads only in Phase 30).
  payload         Json?
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([paymentId])
  @@map("commerce_payment_events")
}

/// Phase 30 supports full refunds only, through the provider abstraction.
model CommerceRefund {
  id               String               @id @default(uuid()) @db.Uuid
  paymentId        String               @map("payment_id") @db.Uuid
  payment          CommercePayment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  orderId          String               @map("order_id") @db.Uuid
  order            CommerceOrder        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  amountCents      Int                  @map("amount_cents")
  currency         String               @db.Char(3)
  reason           String?
  status           CommerceRefundStatus @default(PENDING)
  providerRefundId String?              @map("provider_refund_id")
  idempotencyKey   String               @unique @map("idempotency_key")
  createdBy        String               @map("created_by") @db.Uuid
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([orderId])
  @@map("commerce_refunds")
}
