{
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/s3-request-presigner": "^3.1136.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^5.2.6",
    "@fastify/websocket": "^11.3.1",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/client": "^6.0.0",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "stripe": "^22.6.2"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "prisma": "^6.0.0",
    "tsx": "^4.0.0"
  },
  "name": "@music-streaming/api",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "audio:generate": "tsx scripts/generate-dev-audio.ts",
    "demo:seed": "prisma db seed && tsx prisma/demo-seed.ts",
    "demo:setup": "tsx scripts/demo-setup.ts"
  },
  "type": "module",
  "version": "0.1.0"
}
