{
  "dependencies": {
    "@prisma/client": "^6.0.0"
  },
  "devDependencies": {
    "prisma": "^6.0.0",
    "tsx": "^4.0.0"
  },
  "name": "@music-streaming/api",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
