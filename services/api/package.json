{
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^5.2.6",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/client": "^6.0.0",
    "fastify": "^5.12.5",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "prisma": "^6.0.0",
    "tsx": "^4.0.0"
  },
  "name": "@music-streaming/api",
