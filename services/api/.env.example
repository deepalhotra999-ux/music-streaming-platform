# Copy to .env and fill in. .env is gitignored — never commit real secrets.
# Generate the JWT secret with: openssl rand -base64 48

DATABASE_URL=postgresql://music:music-dev-only-change-me@localhost:5432/musicdb
TEST_DATABASE_URL=postgresql://music:music-dev-only-change-me@localhost:5432/musicdb_test

PORT=3000
JWT_SECRET=change-me-to-at-least-32-random-characters

# Optional overrides (defaults shown):
# JWT_ISSUER=music-streaming
# JWT_AUDIENCE=music-streaming-api
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_SECONDS=2592000
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_LOGIN=10
# RATE_LIMIT_REGISTER=20
# RATE_LIMIT_REFRESH=60
# RATE_LIMIT_LOGOUT=60
# RATE_LIMIT_API=300
# RATE_LIMIT_STREAMING=600

# Phase 7 — streaming (all optional, defaults shown):
# Where audio bytes come from: "local" (implemented) or "s3" (reserved seam
# for AWS S3 + CloudFront; selecting it fails fast until implemented).
# AUDIO_STORAGE_DRIVER=local
# Local driver root: per-track HLS packages live under
# <AUDIO_STORAGE_DIR>/tracks/<trackId>/hls/. Relative paths resolve from the
# API working directory. Generate dev assets with: npm run audio:generate
# AUDIO_STORAGE_DIR=./storage/audio
# Playback session token lifetime, in seconds.
# PLAYBACK_SESSION_TTL_SECONDS=900
