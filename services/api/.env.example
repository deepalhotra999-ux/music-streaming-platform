# Copy to .env and fill in. .env is gitignored — never commit real secrets.
# Generate the JWT secret with: openssl rand -base64 48

DATABASE_URL=postgresql://music:music-dev-only-change-me@localhost:5432/musicdb
TEST_DATABASE_URL=postgresql://music:music-dev-only-change-me@localhost:5432/musicdb_test

PORT=3000
JWT_SECRET=change-me-to-at-least-32-random-characters

# Optional overrides (defaults shown):
# JWT_ISSUER=music-streaming
# JWT_AUDIENCE=music-streaming-api
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_SECONDS=2592000
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_LOGIN=10
# RATE_LIMIT_REGISTER=20
# RATE_LIMIT_REFRESH=60
# RATE_LIMIT_LOGOUT=60
# RATE_LIMIT_API=300
# RATE_LIMIT_STREAMING=600
# Phase 25 — download authorization issuance (tight: each call mints a grant).
# RATE_LIMIT_OFFLINE_AUTHORIZE=60

# Phase 7 — streaming (all optional, defaults shown):
# Where audio bytes come from: "local" (default; needs no AWS config) or
# "s3" (production AWS driver — requires S3_BUCKET; fails fast without it).
# AUDIO_STORAGE_DRIVER=local
# Local driver root: per-track HLS packages live under
# <AUDIO_STORAGE_DIR>/tracks/<trackId>/hls/. Relative paths resolve from the
# API working directory. Generate dev assets with: npm run audio:generate
# AUDIO_STORAGE_DIR=./storage/audio

# Phase 18 — subscriptions & entitlements (all optional, defaults shown):
# Deterministic dev/test subscription adapter. Exposes POST
# /v1/dev/subscription-events with NO store verification (testing only).
# Never true in production — the API refuses to boot with it set there.
# DEV_SUBSCRIPTIONS_ENABLED=false
# Playback session token lifetime, in seconds.
# PLAYBACK_SESSION_TTL_SECONDS=900

# Phase 25 — offline downloads (all optional, defaults shown):
# Delivery-token lifetime: the opaque token that fetches HLS segments for a
# download. Discarded by the client after the download completes.
# OFFLINE_DOWNLOAD_TOKEN_TTL_SECONDS=3600
# Offline entitlement window: offline playback is allowed only inside
# [issuedAt, expiresAt]. Slides forward on successful server revalidation
# while the user stays entitled. Never extended by the client.
# OFFLINE_AUTHORIZATION_TTL_SECONDS=2592000

# Phase 14 — production S3 storage (only used with AUDIO_STORAGE_DRIVER=s3):
# Private bucket holding audio (same tracks/<trackId>/... key scheme).
# Credentials are NOT configured here — they come from the standard AWS
# chain (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY env, shared config, or
# instance role). The bucket must block public access; delivery goes
# through the session-scoped API routes, never permanent public URLs.
# S3_BUCKET=
# S3_REGION=ca-central-1
# Optional key prefix inside the bucket (no leading/trailing slashes).
# S3_PREFIX=

# Phase 14 — artist audio ingestion (all optional, defaults shown):
# Maximum accepted upload size, in bytes (default 100 MiB).
# INGESTION_MAX_UPLOAD_BYTES=104857600

# Phase 19 — Apple App Store subscriptions (all optional).
# The integration is ENABLED only when all four are set; otherwise store
# routes return 503 and the DEV provider remains available for testing.
# APPLE_ENVIRONMENT=Sandbox
# APPLE_BUNDLE_ID=com.waveform.app
# APPLE_KEY_ID=ABC123DEFG
# APPLE_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Inline PEM (use literal \n escapes) or a path to the .p8 key file:
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# APPLE_PRIVATE_KEY_PATH=/run/secrets/apple_private_key.p8

# Phase 19 — Google Play subscriptions (all optional).
# ENABLED only when package name + service account are set.
# GOOGLE_PACKAGE_NAME=com.waveform.app
# Inline service-account JSON or a path to the key file:
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
# GOOGLE_SERVICE_ACCOUNT_JSON_PATH=/run/secrets/google_service_account.json
# Shared secret for the RTDN push endpoint (?token=...):
# GOOGLE_PUBSUB_VERIFICATION_TOKEN=
